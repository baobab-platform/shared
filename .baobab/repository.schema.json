{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baobab-platform.github.io/shared/schemas/repository-v1.json",
  "title": "Baobab Foundation Repository Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "capabilities", "environment", "artifacts"],
  "properties": {
    "schema_version": { "const": 1 },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lifecycle"],
      "properties": {
        "lifecycle": { "enum": ["experimental", "active", "maintenance", "deprecated", "archived"] }
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["python", "node", "go", "java", "rust", "container", "infrastructure", "documentation", "contracts", "github-actions", "digital-estate", "engine", "library", "development-environment"]
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baobab_dev"],
      "properties": {
        "baobab_dev": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required"],
          "properties": {
            "required": { "type": "boolean" },
            "profile": { "enum": ["full", "frontend", "frontend-e2e", "infra"] }
          },
          "allOf": [
            {
              "if": { "properties": { "required": { "const": true } }, "required": ["required"] },
              "then": { "required": ["profile"] }
            }
          ]
        }
      }
    },
    "package_managers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node": { "enum": ["pnpm", "npm", "yarn"] },
        "python": { "enum": ["uv", "pip", "poetry"] },
        "java": { "enum": ["maven", "gradle"] },
        "rust": { "const": "cargo" }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["container"],
      "properties": {
        "container": {
          "oneOf": [
            { "type": "boolean" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "dockerfile", "context", "runtime"],
              "properties": {
                "enabled": { "const": true },
                "dockerfile": { "type": "string", "minLength": 1 },
                "context": { "type": "string", "minLength": 1 },
                "runtime": { "type": "boolean" }
              }
            }
          ]
        }
      }
    },
    "exceptions": {
      "type": "object",
      "propertyNames": {
        "enum": ["baseline", "reproducibility", "runtime", "environment", "dependency-review", "sast", "dependency-audit", "secret-scan", "container-policy", "container-scan", "sbom"]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason", "expires", "approved_by"],
        "properties": {
          "reason": { "type": "string", "minLength": 12 },
          "expires": { "type": "string", "format": "date" },
          "approved_by": { "type": "string", "pattern": "^@[A-Za-z0-9-]+$" }
        }
      }
    }
  }
}