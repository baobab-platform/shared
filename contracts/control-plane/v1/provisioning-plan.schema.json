{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nabhold.com/control-plane/v1/provisioning-plan.schema.json",
  "title": "TenantProvisioning",
  "description": "The tenant onboarding process aggregate (Technical Specification SS21). It does not replace Tenant; it tracks onboarding orchestration. `state` is the coarse, already-implemented provisioning-state-machine.yaml lifecycle (requested/accepted/provisioning/reconciling/active/suspended/failed/decommissioning/cancelled); `current_phase` is the finer-grained orchestration phase within it (domain.schema.json#/$defs/tenantProvisioningPhase) that plan-before-apply (SS25-27) and the onboarding workflow (SS28) require and that the coarse state machine alone cannot express.",
  "$defs": {
    "tenantProvisioning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provisioning_id", "tenant_id", "request_version", "state", "current_phase", "version"],
      "properties": {
        "provisioning_id": { "$ref": "domain.schema.json#/$defs/tenantProvisioningId" },
        "tenant_id": { "$ref": "domain.schema.json#/$defs/tenantId" },
        "request_version": {
          "type": "integer",
          "minimum": 1,
          "description": "Version of the desired-state request this run is provisioning (Technical Specification SS24)."
        },
        "desired_state_version": { "type": "integer", "minimum": 1 },
        "observed_state_version": { "type": "integer", "minimum": 0 },
        "state": {
          "type": "string",
          "enum": ["requested", "accepted", "provisioning", "reconciling", "active", "suspended", "failed", "decommissioning", "cancelled"],
          "description": "The coarse lifecycle state, identical to provisioning-state-machine.yaml and provisioning-state-changed.schema.json's already-shipped enum. Not redefined here; kept in sync by convention."
        },
        "current_phase": { "$ref": "domain.schema.json#/$defs/tenantProvisioningPhase" },
        "product_requests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["product_id"],
            "properties": {
              "product_id": { "$ref": "domain.schema.json#/$defs/productId" },
              "profiles": {
                "type": "array",
                "items": { "$ref": "../../capability/v1/domain.schema.json#/$defs/capabilityCompositionKey" },
                "default": []
              }
            }
          },
          "default": []
        },
        "estate_requests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["estate_id"],
            "properties": {
              "estate_id": { "$ref": "domain.schema.json#/$defs/estateId" },
              "channel": { "type": "string", "maxLength": 64 }
            }
          },
          "default": []
        },
        "market_requests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["market"],
            "properties": {
              "market": { "type": "string", "maxLength": 64 },
              "activities": {
                "type": "array",
                "items": { "type": "string", "maxLength": 64 },
                "default": []
              }
            }
          },
          "default": []
        },
        "isolation_requirement": { "type": "string", "maxLength": 64 },
        "residency_requirement": { "type": "string", "maxLength": 64 },
        "readiness_status": { "$ref": "domain.schema.json#/$defs/readinessStatus" },
        "blocking_reasons": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code"],
            "properties": {
              "code": {
                "type": "string",
                "description": "A capability_resolution_denial code from contracts/authorization/v1/reason-code-registry.yaml (e.g. BINDING_NOT_FOUND), reused rather than duplicated into a fourth reason-code category -- a provisioning blocker is, at root, always a capability resolution failure for some mandatory capability."
              },
              "capability_key": { "$ref": "../../capability/v1/domain.schema.json#/$defs/capabilityKey" },
              "detail": { "type": "string", "maxLength": 500 }
            }
          },
          "default": []
        },
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": ["string", "null"], "format": "date-time" },
        "version": { "type": "integer", "minimum": 1 },
        "metadata": { "type": "object" }
      },
      "if": {
        "properties": { "readiness_status": { "const": "BLOCKED" } },
        "required": ["readiness_status"]
      },
      "then": {
        "required": ["blocking_reasons"],
        "properties": { "blocking_reasons": { "minItems": 1 } }
      }
    }
  }
}
