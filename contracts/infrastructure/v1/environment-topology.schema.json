{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.baobab-platform.com/infrastructure/v1/environment-topology.schema.json",
  "title": "Baobab-Platform environment topology declaration",
  "type": "object",
  "additionalProperties": false,
  "required": ["environment", "region", "classification", "services"],
  "properties": {
    "environment": { "type": "string", "enum": ["local", "development", "staging", "production"] },
    "region": {
      "oneOf": [
        { "const": "local" },
        { "type": "string", "pattern": "^[a-z]{2}-[a-z]+-[0-9]+$" }
      ]
    },
    "classification": { "type": "string", "enum": ["developer_managed", "non_production", "production"] },
    "services": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["apisix", "postgresql", "rabbitmq", "redis", "otel_collector"]
      }
    },
    "data_residency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_regions"],
      "properties": {
        "allowed_regions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "oneOf": [
              { "const": "local" },
              { "type": "string", "pattern": "^[a-z]{2}-[a-z]+-[0-9]+$" }
            ]
          }
        }
      }
    }
  }
}
