{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.baobab-platform.com/rtd-conformance/v1/profile.schema.json",
  "title": "RTD-10 Cross-Repository Conformance Profile",
  "description": "Repository declaration for ADR-SHARED-026. The profile selects a fixed Shared-owned role policy; it cannot redefine the policy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "programme", "repository", "shared", "evidence"],
  "properties": {
    "schema": {"const": "baobab-rtd-conformance"},
    "version": {"const": "1.0"},
    "programme": {"const": "RTD-10"},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "maturity"],
      "properties": {
        "id": {"enum": ["baobab-regulations", "baobab-trade-docs", "baobab-pulse"]},
        "role": {"enum": ["REGULATIONS_AUTHORITY", "TRADE_DOCUMENT_AUTHORITY", "INTELLIGENCE_CONSUMER"]},
        "maturity": {"enum": ["ARCHITECTURE_ONLY", "DOMAIN_RUNTIME", "IMPLEMENTED_CONSUMER"]}
      }
    },
    "shared": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "required_contracts"],
      "properties": {
        "repository": {"const": "baobab-platform/shared"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "required_contracts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^contracts/[A-Za-z0-9._/-]+$"}
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adr_paths", "source_paths", "test_paths"],
      "properties": {
        "adr_paths": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^docs/adr/.+\\.md$"}
        },
        "source_paths": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "test_paths": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "repository": {
            "properties": {"role": {"const": "REGULATIONS_AUTHORITY"}},
            "required": ["role"]
          }
        }
      },
      "then": {
        "properties": {
          "repository": {
            "properties": {
              "id": {"const": "baobab-regulations"},
              "maturity": {"const": "DOMAIN_RUNTIME"}
            }
          },
          "evidence": {
            "properties": {
              "source_paths": {"minItems": 1},
              "test_paths": {"minItems": 1}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "repository": {
            "properties": {"role": {"const": "TRADE_DOCUMENT_AUTHORITY"}},
            "required": ["role"]
          }
        }
      },
      "then": {
        "properties": {
          "repository": {
            "properties": {
              "id": {"const": "baobab-trade-docs"},
              "maturity": {"const": "ARCHITECTURE_ONLY"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "repository": {
            "properties": {"role": {"const": "INTELLIGENCE_CONSUMER"}},
            "required": ["role"]
          }
        }
      },
      "then": {
        "properties": {
          "repository": {
            "properties": {
              "id": {"const": "baobab-pulse"},
              "maturity": {"const": "IMPLEMENTED_CONSUMER"}
            }
          },
          "evidence": {
            "properties": {
              "source_paths": {"minItems": 1},
              "test_paths": {"minItems": 1}
            }
          }
        }
      }
    }
  ]
}
