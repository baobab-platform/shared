{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.baobab-platform.com/contracts/identity-events/v1/membership-revoked.schema.json",
  "title": "MembershipRevokedEvent",
  "description": "Emitted when a membership is revoked. This is the event envelope's `data` payload — see asyncapi.yaml for how it composes with contracts/events/v1/envelope.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["membership_id", "principal_id", "resource_type", "resource_id", "new_status", "reason", "actor"],
  "properties": {
    "membership_id": {
      "type": "string",
      "format": "uuid"
    },
    "principal_id": {
      "type": "string",
      "format": "uuid"
    },
    "resource_type": {
      "type": "string"
    },
    "resource_id": {
      "type": "string"
    },
    "previous_status": {
      "type": "string",
      "enum": ["ACTIVE", "SUSPENDED"]
    },
    "new_status": {
      "type": "string",
      "enum": ["REVOKED", "EXPIRED"]
    },
    "reason": {
      "type": "string"
    },
    "actor": {
      "type": "string"
    }
  }
}
