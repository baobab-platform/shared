{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.baobab-platform.com/buyer-organisation/v1/events.schema.json",
  "title": "Buyer onboarding lifecycle event payloads",
  "$defs": {
    "buyerApplicationSubmittedEventData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buyer_application_id",
        "tenant_id",
        "applicant_principal_id",
        "status",
        "revision"
      ],
      "properties": {
        "buyer_application_id": {
          "$ref": "domain.schema.json#/$defs/buyerApplicationId"
        },
        "tenant_id": {
          "$ref": "../../control-plane/v1/domain.schema.json#/$defs/tenantId"
        },
        "applicant_principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "$ref": "domain.schema.json#/$defs/buyerApplicationStatus"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "buyerApplicationDecisionEventData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buyer_application_id",
        "tenant_id",
        "decision",
        "decided_by_principal_id",
        "decision_reference"
      ],
      "properties": {
        "buyer_application_id": {
          "$ref": "domain.schema.json#/$defs/buyerApplicationId"
        },
        "tenant_id": {
          "$ref": "../../control-plane/v1/domain.schema.json#/$defs/tenantId"
        },
        "decision": {
          "type": "string",
          "enum": [
            "APPROVED",
            "REJECTED"
          ]
        },
        "decided_by_principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "decision_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reason_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        }
      }
    },
    "buyerOrganisationRegisteredEventData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buyer_organisation_id",
        "tenant_id",
        "name",
        "status"
      ],
      "properties": {
        "buyer_organisation_id": {
          "$ref": "domain.schema.json#/$defs/buyerOrganisationId"
        },
        "tenant_id": {
          "$ref": "../../control-plane/v1/domain.schema.json#/$defs/tenantId"
        },
        "canonical_organisation_id": {
          "anyOf": [
            {
              "$ref": "../../control-plane/v1/domain.schema.json#/$defs/canonicalEntityId"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_application_id": {
          "anyOf": [
            {
              "$ref": "domain.schema.json#/$defs/buyerApplicationId"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "legal_name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "status": {
          "$ref": "domain.schema.json#/$defs/buyerOrganisationStatus"
        }
      }
    },
    "buyerOrganisationStatusChangedEventData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buyer_organisation_id",
        "tenant_id",
        "status"
      ],
      "properties": {
        "buyer_organisation_id": {
          "$ref": "domain.schema.json#/$defs/buyerOrganisationId"
        },
        "tenant_id": {
          "$ref": "../../control-plane/v1/domain.schema.json#/$defs/tenantId"
        },
        "previous_status": {
          "$ref": "domain.schema.json#/$defs/buyerOrganisationStatus"
        },
        "status": {
          "$ref": "domain.schema.json#/$defs/buyerOrganisationStatus"
        },
        "changed_by_principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reason_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        }
      }
    },
    "buyerMembershipChangedEventData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buyer_membership_id",
        "buyer_organisation_id",
        "tenant_id",
        "principal_id",
        "customer_id",
        "status",
        "roles"
      ],
      "properties": {
        "buyer_membership_id": {
          "$ref": "domain.schema.json#/$defs/buyerMembershipId"
        },
        "buyer_organisation_id": {
          "$ref": "domain.schema.json#/$defs/buyerOrganisationId"
        },
        "tenant_id": {
          "$ref": "../../control-plane/v1/domain.schema.json#/$defs/tenantId"
        },
        "principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "$ref": "domain.schema.json#/$defs/buyerMembershipStatus"
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "domain.schema.json#/$defs/buyerRole"
          }
        },
        "customer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "buyerCommercialProfileChangedEventData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buyer_organisation_id",
        "tenant_id",
        "source_system",
        "credit_status",
        "currency_code",
        "as_of"
      ],
      "properties": {
        "buyer_organisation_id": {
          "$ref": "domain.schema.json#/$defs/buyerOrganisationId"
        },
        "tenant_id": {
          "$ref": "../../control-plane/v1/domain.schema.json#/$defs/tenantId"
        },
        "source_system": {
          "type": "string",
          "enum": [
            "ERP",
            "TRADE"
          ]
        },
        "credit_status": {
          "type": "string",
          "enum": [
            "NOT_ASSESSED",
            "PENDING",
            "APPROVED",
            "ON_HOLD",
            "REJECTED"
          ]
        },
        "payment_term_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "credit_limit_minor": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "currency_code": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "profile_reference": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128,
          "description": "Retrievable authoritative snapshot reference when a consumer needs fields beyond this event."
        },
        "legal_entity_id": {
          "anyOf": [
            {
              "$ref": "../../control-plane/v1/domain.schema.json#/$defs/legalEntityId"
            },
            {
              "type": "null"
            }
          ],
          "description": "ERP legal-entity scope; ERP producers populate it, retained optional for v1 compatibility."
        },
        "business_partner_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^erp_[a-z0-9]+$",
          "description": "Public ERP identifier; never a native C_BPartner_ID."
        }
      }
    },
    "buyerErpProjectionRequestedEventData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buyer_organisation_id",
        "canonical_organisation_id",
        "tenant_id",
        "legal_entity_id",
        "display_name",
        "billing_country",
        "default_currency",
        "source_version"
      ],
      "properties": {
        "buyer_organisation_id": {
          "$ref": "domain.schema.json#/$defs/buyerOrganisationId"
        },
        "canonical_organisation_id": {
          "$ref": "../../control-plane/v1/domain.schema.json#/$defs/canonicalEntityId"
        },
        "tenant_id": {
          "$ref": "../../control-plane/v1/domain.schema.json#/$defs/tenantId"
        },
        "legal_entity_id": {
          "$ref": "../../control-plane/v1/domain.schema.json#/$defs/legalEntityId"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "billing_country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "default_currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "source_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "requested_by_principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  }
}
