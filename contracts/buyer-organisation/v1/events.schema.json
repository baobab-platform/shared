{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.baobab-platform.com/buyer-organisation/v1/events.schema.json",
  "title": "Buyer onboarding lifecycle event payloads",
  "$defs": {
    "buyerApplicationSubmittedEventData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buyer_application_id",
        "tenant_id",
        "applicant_principal_id",
        "status",
        "revision"
      ],
      "properties": {
        "buyer_application_id": {
          "$ref": "domain.schema.json#/$defs/buyerApplicationId"
        },
        "tenant_id": {
          "$ref": "../../control-plane/v1/domain.schema.json#/$defs/tenantId"
        },
        "applicant_principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "$ref": "domain.schema.json#/$defs/buyerApplicationStatus"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "buyerApplicationDecisionEventData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buyer_application_id",
        "tenant_id",
        "decision",
        "decided_by_principal_id",
        "decision_reference"
      ],
      "properties": {
        "buyer_application_id": {
          "$ref": "domain.schema.json#/$defs/buyerApplicationId"
        },
        "tenant_id": {
          "$ref": "../../control-plane/v1/domain.schema.json#/$defs/tenantId"
        },
        "decision": {
          "type": "string",
          "enum": [
            "APPROVED",
            "REJECTED"
          ]
        },
        "decided_by_principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "decision_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reason_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        }
      }
    },
    "buyerOrganisationRegisteredEventData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buyer_organisation_id",
        "tenant_id",
        "canonical_organisation_id",
        "legal_name",
        "status"
      ],
      "properties": {
        "buyer_organisation_id": {
          "$ref": "domain.schema.json#/$defs/buyerOrganisationId"
        },
        "tenant_id": {
          "$ref": "../../control-plane/v1/domain.schema.json#/$defs/tenantId"
        },
        "canonical_organisation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_application_id": {
          "$ref": "domain.schema.json#/$defs/buyerApplicationId"
        },
        "legal_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "$ref": "domain.schema.json#/$defs/buyerOrganisationStatus"
        }
      }
    },
    "buyerOrganisationStatusChangedEventData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buyer_organisation_id",
        "tenant_id",
        "previous_status",
        "status",
        "changed_by_principal_id"
      ],
      "properties": {
        "buyer_organisation_id": {
          "$ref": "domain.schema.json#/$defs/buyerOrganisationId"
        },
        "tenant_id": {
          "$ref": "../../control-plane/v1/domain.schema.json#/$defs/tenantId"
        },
        "previous_status": {
          "$ref": "domain.schema.json#/$defs/buyerOrganisationStatus"
        },
        "status": {
          "$ref": "domain.schema.json#/$defs/buyerOrganisationStatus"
        },
        "changed_by_principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reason_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        }
      }
    },
    "buyerMembershipChangedEventData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buyer_membership_id",
        "buyer_organisation_id",
        "tenant_id",
        "principal_id",
        "status",
        "roles"
      ],
      "properties": {
        "buyer_membership_id": {
          "$ref": "domain.schema.json#/$defs/buyerMembershipId"
        },
        "buyer_organisation_id": {
          "$ref": "domain.schema.json#/$defs/buyerOrganisationId"
        },
        "tenant_id": {
          "$ref": "../../control-plane/v1/domain.schema.json#/$defs/tenantId"
        },
        "principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "$ref": "domain.schema.json#/$defs/buyerMembershipStatus"
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "domain.schema.json#/$defs/buyerRole"
          }
        }
      }
    },
    "buyerCommercialProfileChangedEventData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buyer_organisation_id",
        "tenant_id",
        "source_system",
        "as_of"
      ],
      "properties": {
        "buyer_organisation_id": {
          "$ref": "domain.schema.json#/$defs/buyerOrganisationId"
        },
        "tenant_id": {
          "$ref": "../../control-plane/v1/domain.schema.json#/$defs/tenantId"
        },
        "source_system": {
          "type": "string",
          "enum": [
            "ERP",
            "TRADE"
          ]
        },
        "credit_status": {
          "type": "string",
          "enum": [
            "NOT_ASSESSED",
            "PENDING",
            "APPROVED",
            "ON_HOLD",
            "REJECTED"
          ]
        },
        "payment_term_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
