{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.baobab-platform.com/buyer-organisation/v1/domain.schema.json",
  "title": "Baobab BuyerOrganisation onboarding and trading-account domain",
  "description": "Gate ZB-04 contract for a tenant-owned B2B buyer counterparty. Trade owns the commercial application and trading-account lifecycle. Control Plane owns the canonical BUYER_ORGANISATION identity and tenant/context attestation; IAM authenticates people; ERP owns authoritative credit and accounting consequences.",
  "$defs": {
    "buyerOrganisationId": {
      "type": "string",
      "pattern": "^buyerorg_[a-z0-9]+$",
      "minLength": 10,
      "maxLength": 63,
      "description": "Opaque BuyerOrganisation identifier used by the cross-engine contract."
    },
    "buyerApplicationId": {
      "type": "string",
      "pattern": "^buyerapp_[a-z0-9]+$",
      "minLength": 10,
      "maxLength": 63
    },
    "buyerMembershipId": {
      "type": "string",
      "pattern": "^buyermem_[a-z0-9]+$",
      "minLength": 10,
      "maxLength": 63
    },
    "buyerSiteId": {
      "type": "string",
      "pattern": "^buyersite_[a-z0-9]+$",
      "minLength": 10,
      "maxLength": 63
    },
    "buyerOrganisationStatus": {
      "type": "string",
      "enum": [
        "PENDING",
        "ACTIVE",
        "SUSPENDED",
        "ARCHIVED"
      ]
    },
    "buyerApplicationStatus": {
      "type": "string",
      "enum": [
        "DRAFT",
        "SUBMITTED",
        "INFORMATION_REQUIRED",
        "UNDER_REVIEW",
        "APPROVED",
        "REJECTED",
        "WITHDRAWN"
      ]
    },
    "buyerMembershipStatus": {
      "type": "string",
      "enum": [
        "INVITED",
        "ACTIVE",
        "SUSPENDED",
        "REVOKED"
      ]
    },
    "buyerRole": {
      "type": "string",
      "enum": [
        "BUYER",
        "SENIOR_BUYER",
        "APPROVER",
        "PROCUREMENT_MANAGER",
        "ACCOUNT_ADMIN",
        "VIEWER"
      ]
    },
    "siteType": {
      "type": "string",
      "enum": [
        "DELIVERY",
        "BILLING"
      ]
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line_1",
        "city",
        "country_code"
      ],
      "properties": {
        "line_1": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "line_2": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "administrative_area": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "postal_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32
        },
        "country_code": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        }
      }
    },
    "buyerApplication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buyer_application_id",
        "tenant_id",
        "applicant_principal_id",
        "legal_name",
        "status",
        "revision"
      ],
      "properties": {
        "buyer_application_id": {
          "$ref": "#/$defs/buyerApplicationId"
        },
        "tenant_id": {
          "$ref": "../../control-plane/v1/domain.schema.json#/$defs/tenantId"
        },
        "applicant_principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "legal_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "trading_name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "registration_number": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "country_of_registration": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{2}$"
        },
        "website": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "requested_market_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "status": {
          "$ref": "#/$defs/buyerApplicationStatus"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "submitted_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "decided_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "decision_reason_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "buyerOrganisation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buyer_organisation_id",
        "tenant_id",
        "canonical_organisation_id",
        "legal_name",
        "status"
      ],
      "properties": {
        "buyer_organisation_id": {
          "$ref": "#/$defs/buyerOrganisationId"
        },
        "tenant_id": {
          "$ref": "../../control-plane/v1/domain.schema.json#/$defs/tenantId"
        },
        "legal_entity_id": {
          "$ref": "../../control-plane/v1/domain.schema.json#/$defs/legalEntityId"
        },
        "canonical_organisation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Control Plane canonical entity ID of kind BUYER_ORGANISATION; never a Keycloak or engine-native ID."
        },
        "source_application_id": {
          "$ref": "#/$defs/buyerApplicationId"
        },
        "legal_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "trading_name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "registration_number": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "status": {
          "$ref": "#/$defs/buyerOrganisationStatus"
        },
        "default_market_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "currency_code": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "buyerMembership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buyer_membership_id",
        "buyer_organisation_id",
        "principal_id",
        "customer_id",
        "status",
        "roles"
      ],
      "properties": {
        "buyer_membership_id": {
          "$ref": "#/$defs/buyerMembershipId"
        },
        "buyer_organisation_id": {
          "$ref": "#/$defs/buyerOrganisationId"
        },
        "principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "customer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "$ref": "#/$defs/buyerMembershipStatus"
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/buyerRole"
          }
        }
      }
    },
    "buyerSite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buyer_site_id",
        "buyer_organisation_id",
        "site_type",
        "name",
        "address"
      ],
      "properties": {
        "buyer_site_id": {
          "$ref": "#/$defs/buyerSiteId"
        },
        "buyer_organisation_id": {
          "$ref": "#/$defs/buyerOrganisationId"
        },
        "site_type": {
          "$ref": "#/$defs/siteType"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "address": {
          "$ref": "#/$defs/address"
        },
        "tax_registration_reference": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        }
      }
    },
    "commercialProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buyer_organisation_id"
      ],
      "properties": {
        "buyer_organisation_id": {
          "$ref": "#/$defs/buyerOrganisationId"
        },
        "erp_business_partner_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "credit_status": {
          "type": "string",
          "enum": [
            "NOT_ASSESSED",
            "PENDING",
            "APPROVED",
            "ON_HOLD",
            "REJECTED"
          ]
        },
        "credit_limit_minor": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "currency_code": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        },
        "payment_term_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "price_agreement_references": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 128
          }
        },
        "contract_references": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 128
          }
        },
        "source_system": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "ERP",
            "TRADE",
            null
          ]
        },
        "as_of": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  }
}
