{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.baobab-platform.com/erp/v1/inventory-availability.schema.json",
  "title": "ERP physical inventory availability projection",
  "description": "ERP-owned physical availability for a mapped SKU and warehouse. Trade reservations are not overwritten by this projection.",
  "type": "object",
  "additionalProperties": false,
  "required": ["legal_entity_id", "sku_id", "warehouse_id", "on_hand", "erp_allocated", "erp_available", "as_of", "revision"],
  "properties": {
    "legal_entity_id": { "$ref": "../../control-plane/v1/domain.schema.json#/$defs/legalEntityId" },
    "sku_id": { "$ref": "./domain.schema.json#/$defs/canonicalResourceId" },
    "warehouse_id": { "$ref": "./domain.schema.json#/$defs/erpResourceId" },
    "on_hand": { "$ref": "./domain.schema.json#/$defs/quantity" },
    "erp_allocated": { "$ref": "./domain.schema.json#/$defs/quantity" },
    "erp_available": { "$ref": "./domain.schema.json#/$defs/quantity" },
    "as_of": { "$ref": "./domain.schema.json#/$defs/timestamp" },
    "revision": { "$ref": "./domain.schema.json#/$defs/version" }
  }
}
