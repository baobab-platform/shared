{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.baobab-platform.com/erp/v1/mapping.schema.json",
  "title": "Canonical-to-ERP mapping",
  "description": "Public, temporal mapping metadata. Vendor bindings remain private to the ERP adapter and are deliberately absent.",
  "type": "object",
  "additionalProperties": false,
  "required": ["mapping_id", "tenant_id", "legal_entity_id", "canonical_reference", "erp_resource_id", "status", "revision", "effective_from"],
  "properties": {
    "mapping_id": { "$ref": "./domain.schema.json#/$defs/mappingId" },
    "tenant_id": { "$ref": "../../control-plane/v1/domain.schema.json#/$defs/tenantId" },
    "legal_entity_id": { "$ref": "../../control-plane/v1/domain.schema.json#/$defs/legalEntityId" },
    "canonical_reference": { "$ref": "./domain.schema.json#/$defs/canonicalReference" },
    "erp_resource_id": { "$ref": "./domain.schema.json#/$defs/erpResourceId" },
    "status": { "type": "string", "enum": ["pending", "active", "suspended", "retired", "quarantined"] },
    "revision": { "$ref": "./domain.schema.json#/$defs/version" },
    "effective_from": { "$ref": "./domain.schema.json#/$defs/timestamp" },
    "effective_to": { "oneOf": [{ "$ref": "./domain.schema.json#/$defs/timestamp" }, { "type": "null" }] },
    "replaces_mapping_id": { "$ref": "./domain.schema.json#/$defs/mappingId" }
  }
}
