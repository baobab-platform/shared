              ]
            },
            "prohibited_effect_count": {
              "type": "integer",
              "minimum": 0
            },
            "eligible_effect_count": {
              "type": "integer",
              "minimum": 0
            },
            "retry_count": {
              "type": "integer",
              "minimum": 0
            },
            "retry_limit": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "post_commit_pre_ack_crash": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "prohibited_effect_count",
            "eligible_effect_count",
            "retry_count",
            "retry_limit"
          ],
          "properties": {
            "status": {
              "enum": [
                "PASS",
                "FAIL",
                "BLOCKED"
              ]
            },
            "prohibited_effect_count": {
              "type": "integer",
              "minimum": 0
            },
            "eligible_effect_count": {
              "type": "integer",
              "minimum": 0
            },
            "retry_count": {
              "type": "integer",
              "minimum": 0
            },
            "retry_limit": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "ambiguous_erp_outcome": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "prohibited_effect_count",
            "eligible_effect_count",
            "retry_count",
            "retry_limit"
          ],
          "properties": {
            "status": {
              "enum": [
                "PASS",
                "FAIL",
                "BLOCKED"
              ]
            },
            "prohibited_effect_count": {
              "type": "integer",
              "minimum": 0
            },
            "eligible_effect_count": {
              "type": "integer",
              "minimum": 0
            },
            "retry_count": {
              "type": "integer",
              "minimum": 0
            },
            "retry_limit": {
              "type": "integer",
              "minimum": 0
