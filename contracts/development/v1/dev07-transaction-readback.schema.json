      },
      "required": [
        "wrong_tenant_company",
        "invalid_audience",
        "revoked_mandate",
        "stale_buyer_authority",
        "changed_event_payload",
        "duplicate_delivery",
        "expired_lease",
        "simultaneous_reservation",
        "publisher_outage",
        "post_commit_pre_ack_crash",
        "ambiguous_erp_outcome"
      ]
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "int05_qualified",
        "provider_qualified",
        "protected_acceptance",
        "production_authorized"
      ],
      "properties": {
        "int05_qualified": {
          "const": false
        },
        "provider_qualified": {
          "const": false
        },
        "protected_acceptance": {
          "const": false
        },
        "production_authorized": {
          "const": false
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "positive_status": {
            "const": "OBSERVED"
          }
        }
      },
      "then": {
        "properties": {
          "observations": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "observations": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_class": {
            "const": "SCHEMA_TEST_VECTOR"
          }
        }
      },
      "then": {
        "properties": {
          "observer": {
            "properties": {
              "kind": {
                "const": "SCHEMA_TEST_VECTOR"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_class": {
            "const": "REAL_COMPONENT_SYNTHETIC_DATA"
          }
        }
      },
      "then": {
        "properties": {
          "observer": {
            "properties": {
              "kind": {
                "const": "INDEPENDENT_READBACK"
              }
            }
          }
        }
      }
    }
  ]
}
