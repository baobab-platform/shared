{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.baobab-platform.com/trade/v1/rfq.schema.json",
  "title": "Request for quotation",
  "type": "object",
  "additionalProperties": false,
  "required": ["rfq_id", "context", "status", "lines", "version", "created_at", "updated_at"],
  "properties": {
    "rfq_id": { "$ref": "domain.schema.json#/$defs/resourceId" },
    "context": { "$ref": "domain.schema.json#/$defs/buyerContext" },
    "status": { "type": "string", "enum": ["DRAFT", "SUBMITTED", "UNDER_REVIEW", "QUOTED", "DECLINED", "WITHDRAWN", "EXPIRED", "CLOSED"] },
    "reference": { "type": "string", "maxLength": 120 },
    "notes": { "type": "string", "maxLength": 4000 },
    "requested_delivery_date": { "type": "string", "format": "date" },
    "requested_incoterm": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "lines": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "domain.schema.json#/$defs/lineInput" } },
    "version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
