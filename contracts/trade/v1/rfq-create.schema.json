{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nabhold.com/trade/v1/rfq-create.schema.json",
  "title": "Create request for quotation command",
  "type": "object",
  "additionalProperties": false,
  "required": ["context", "lines"],
  "properties": {
    "context": { "$ref": "domain.schema.json#/$defs/buyerContext" },
    "reference": { "type": "string", "maxLength": 120 },
    "notes": { "type": "string", "maxLength": 4000 },
    "requested_delivery_date": { "type": "string", "format": "date" },
    "requested_incoterm": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "lines": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "domain.schema.json#/$defs/lineInput" } }
  },
  "description": "The caller requests context and terms. Trade mints rfq_id, lifecycle status, version and timestamps."
}
