{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.baobab-platform.com/organisation/v1/mapping.schema.json",
  "title": "Baobab Tenant–Organisation and Tenant–LegalEntity Mapping Contracts (ADR-BCP-018)",
  "description": "Target path: baobab-platform/shared/contracts/organisation/v1/mapping.schema.json\n\nDefinition library. Explicit mappings replace implicit singular Tenant.LegalEntityID over time.\nThe row with mapping_role DEFAULT (or is_default=true) is the compatibility projection of Tenant.LegalEntityID.\nReuse control-plane/v1 tenantId and canonicalLegalEntityId.",
  "type": "object",
  "additionalProperties": false,
  "properties": {},
  "$defs": {
    "tenantOrganisationMappingRole": {
      "type": "string",
      "enum": [
        "PRIMARY_ORGANISATION",
        "OPERATING_ORGANISATION",
        "ADDITIONAL_ORGANISATION",
        "DEFAULT"
      ]
    },
    "tenantLegalEntityMappingRole": {
      "type": "string",
      "enum": [
        "DEFAULT",
        "PRIMARY",
        "ADDITIONAL"
      ]
    },
    "TenantOrganisationMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tenant_id",
        "organisation_id",
        "mapping_role",
        "status",
        "effective_from",
        "provenance"
      ],
      "properties": {
        "id": {
          "$ref": "https://contracts.baobab-platform.com/control-plane/v1/domain.schema.json#/$defs/mappingId"
        },
        "tenant_id": {
          "$ref": "https://contracts.baobab-platform.com/control-plane/v1/domain.schema.json#/$defs/tenantId"
        },
        "organisation_id": {
          "$ref": "https://contracts.baobab-platform.com/control-plane/v1/domain.schema.json#/$defs/canonicalEntityId"
        },
        "mapping_role": { "$ref": "#/$defs/tenantOrganisationMappingRole" },
        "is_default": {
          "type": "boolean",
          "default": false,
          "description": "Compatibility flag. Prefer mapping_role DEFAULT. At most one active default per tenant."
        },
        "status": {
          "type": "string",
          "enum": ["ACTIVE", "SUSPENDED", "RETIRED"]
        },
        "effective_from": { "type": "string", "format": "date-time" },
        "effective_to": { "type": "string", "format": "date-time" },
        "provenance": {
          "type": "string",
          "minLength": 1,
          "description": "How this mapping was established (admission, backfill, governance, etc.)."
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "TenantLegalEntityMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tenant_id",
        "legal_entity_id",
        "mapping_role",
        "status",
        "effective_from",
        "provenance"
      ],
      "properties": {
        "id": {
          "$ref": "https://contracts.baobab-platform.com/control-plane/v1/domain.schema.json#/$defs/mappingId"
        },
        "tenant_id": {
          "$ref": "https://contracts.baobab-platform.com/control-plane/v1/domain.schema.json#/$defs/tenantId"
        },
        "legal_entity_id": {
          "$ref": "https://contracts.baobab-platform.com/control-plane/v1/domain.schema.json#/$defs/canonicalLegalEntityId"
        },
        "mapping_role": { "$ref": "#/$defs/tenantLegalEntityMappingRole" },
        "is_default": {
          "type": "boolean",
          "default": false,
          "description": "Compatibility projection of Tenant.LegalEntityID when true."
        },
        "status": {
          "type": "string",
          "enum": ["ACTIVE", "SUSPENDED", "RETIRED"]
        },
        "effective_from": { "type": "string", "format": "date-time" },
        "effective_to": { "type": "string", "format": "date-time" },
        "provenance": {
          "type": "string",
          "minLength": 1
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
