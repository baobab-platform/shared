{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.baobab-platform.com/organisation/v1/domain.schema.json",
  "title": "Baobab Organisation Domain Contracts (ADR-BCP-018)",
  "description": "Target path: baobab-platform/shared/contracts/organisation/v1/domain.schema.json\n\nDefinition library for Organisation and LegalEntityProfile.\nValidate resources against fragment URIs (e.g. #/$defs/Organisation), not the document root.\n\nShared = contract/schema authority and first-party governance source.\nControl Plane = runtime authority for Organisation and LegalEntityProfile instances.\n\nReuse control-plane/v1 identity spine via $ref where practical.",
  "type": "object",
  "additionalProperties": false,
  "properties": {},
  "$defs": {
    "organisationForm": {
      "type": "string",
      "description": "Organisational form only. MUST NOT encode commercial role (SUPPLIER/CUSTOMER).",
      "enum": [
        "COMPANY",
        "PARTNERSHIP",
        "TRUST",
        "ASSOCIATION",
        "PUBLIC_BODY",
        "NONPROFIT",
        "UNINCORPORATED_ORGANISATION",
        "SOLE_PROPRIETOR",
        "COOPERATIVE",
        "GOVERNMENT_ENTITY",
        "FINANCIAL_INSTITUTION",
        "OTHER"
      ]
    },
    "verificationState": {
      "type": "string",
      "description": "Evidence state. Consequential decisions MUST fail closed unless VERIFIED.",
      "enum": [
        "UNVERIFIED",
        "PENDING_REVIEW",
        "VERIFIED",
        "CONFLICTED",
        "REJECTED",
        "EXPIRED"
      ]
    },
    "lifecycleStatus": {
      "type": "string",
      "enum": [
        "DRAFT",
        "VALIDATED",
        "ACTIVE",
        "DEPRECATED",
        "SUSPENDED",
        "MIGRATING",
        "QUARANTINED",
        "RETIRED"
      ]
    },
    "organisationIdentifier": {
      "type": "object",
      "required": ["type", "value"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "COMPANY_REGISTRATION",
            "TAX_IDENTIFIER",
            "VAT_IDENTIFIER",
            "CUSTOMS_IDENTIFIER",
            "IMPORTER_IDENTIFIER",
            "EXPORTER_IDENTIFIER",
            "LEI",
            "OTHER"
          ]
        },
        "value": { "type": "string", "minLength": 1 },
        "issuing_jurisdiction": { "type": "string" },
        "issuer": { "type": "string" },
        "verified": { "type": "boolean", "default": false },
        "valid_from": { "type": "string", "format": "date-time" },
        "valid_to": { "type": "string", "format": "date-time" }
      }
    },
    "organisationAddress": {
      "type": "object",
      "required": ["address_type"],
      "additionalProperties": false,
      "properties": {
        "address_type": {
          "type": "string",
          "enum": [
            "REGISTERED",
            "BILLING",
            "SHIPPING",
            "WAREHOUSE",
            "OPERATING",
            "CORRESPONDENCE"
          ]
        },
        "lines": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "locality": { "type": "string" },
        "region": { "type": "string" },
        "postal_code": { "type": "string" },
        "country_code": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "verified": { "type": "boolean", "default": false }
      }
    },
    "Organisation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_entity_id",
        "display_name",
        "verification_state",
        "source_authority",
        "status",
        "effective_from"
      ],
      "properties": {
        "canonical_entity_id": {
          "$ref": "https://contracts.baobab-platform.com/control-plane/v1/domain.schema.json#/$defs/canonicalEntityId",
          "description": "Platform CanonicalEntity identifier. Organisation identity is never independent of CanonicalEntity."
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "official_name": { "type": "string" },
        "trading_names": {
          "type": "array",
          "items": { "type": "string" }
        },
        "organisation_form": { "$ref": "#/$defs/organisationForm" },
        "jurisdiction": { "type": "string" },
        "verification_state": { "$ref": "#/$defs/verificationState" },
        "source_authority": {
          "type": "string",
          "minLength": 1,
          "description": "Authoritative source that established or last verified this Organisation record."
        },
        "status": { "$ref": "#/$defs/lifecycleStatus" },
        "effective_from": { "type": "string", "format": "date-time" },
        "effective_to": { "type": "string", "format": "date-time" },
        "identifiers": {
          "type": "array",
          "items": { "$ref": "#/$defs/organisationIdentifier" }
        },
        "addresses": {
          "type": "array",
          "items": { "$ref": "#/$defs/organisationAddress" }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "LegalEntityProfile": {
      "type": "object",
      "additionalProperties": false,
      "description": "Legally recognised person attached to an Organisation. organisation_id and legal_entity_id remain distinct. Runtime instances are Control Plane authority; Shared governs first-party registry ids only.",
      "required": [
        "legal_entity_id",
        "organisation_id",
        "legal_name",
        "legal_status",
        "source_authority",
        "verification_state",
        "effective_from"
      ],
      "properties": {
        "legal_entity_id": {
          "$ref": "https://contracts.baobab-platform.com/control-plane/v1/domain.schema.json#/$defs/canonicalLegalEntityId",
          "description": "Canonical legal-entity identifier known to Control Plane. First-party IDs reconcile to Shared governance; external IDs are Control-Plane-issued (prefer opaque LE-<token> form for new external admissions)."
        },
        "organisation_id": {
          "$ref": "https://contracts.baobab-platform.com/control-plane/v1/domain.schema.json#/$defs/canonicalEntityId"
        },
        "legal_name": { "type": "string", "minLength": 1 },
        "jurisdiction_of_incorporation": { "type": "string" },
        "registration_identifiers": {
          "type": "array",
          "items": { "$ref": "#/$defs/organisationIdentifier" }
        },
        "incorporation_date": { "type": "string", "format": "date" },
        "legal_status": { "type": "string", "minLength": 1 },
        "source_authority": { "type": "string", "minLength": 1 },
        "verification_state": { "$ref": "#/$defs/verificationState" },
        "effective_from": { "type": "string", "format": "date-time" },
        "effective_to": { "type": "string", "format": "date-time" },
        "evidence_references": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Opaque references to evidence in a document system. Binaries are not stored here."
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
