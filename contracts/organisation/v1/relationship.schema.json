{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.baobab-platform.com/organisation/v1/platform.schema.json",
  "title": "Baobab Platform Relationship and Platform Account Contracts (ADR-BCP-018)",
  "description": "Target path: baobab-platform/shared/contracts/organisation/v1/platform.schema.json\n\nDefinition library. An Organisation may have concurrent PlatformRelationships (e.g. PLATFORM_PARTNER + EXTERNAL_CLIENT).\nPrivileged types are server-authoritative. PLATFORM_GROUP_AFFILIATE != runtime permission.",
  "type": "object",
  "additionalProperties": false,
  "properties": {},
  "$defs": {
    "verificationState": {
      "$ref": "https://contracts.baobab-platform.com/organisation/v1/domain.schema.json#/$defs/verificationState"
    },
    "platformRelationshipType": {
      "type": "string",
      "enum": [
        "PLATFORM_OWNER",
        "PLATFORM_OPERATOR",
        "PLATFORM_GROUP_AFFILIATE",
        "PLATFORM_PARTNER",
        "EXTERNAL_CLIENT",
        "MANAGED_ENTITY"
      ]
    },
    "PlatformRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "platform_id",
        "organisation_id",
        "relationship_type",
        "verification_state",
        "source_authority",
        "status",
        "effective_from"
      ],
      "properties": {
        "id": {
          "$ref": "https://contracts.baobab-platform.com/control-plane/v1/domain.schema.json#/$defs/mappingId"
        },
        "platform_id": {
          "type": "string",
          "minLength": 1,
          "description": "Identifier of the Baobab Platform instance or product plane this relationship is with."
        },
        "organisation_id": {
          "$ref": "https://contracts.baobab-platform.com/control-plane/v1/domain.schema.json#/$defs/canonicalEntityId"
        },
        "relationship_type": { "$ref": "#/$defs/platformRelationshipType" },
        "verification_state": { "$ref": "#/$defs/verificationState" },
        "status": {
          "type": "string",
          "enum": ["ACTIVE", "SUSPENDED", "RETIRED", "PENDING"]
        },
        "effective_from": { "type": "string", "format": "date-time" },
        "effective_to": { "type": "string", "format": "date-time" },
        "basis_relationship_id": {
          "$ref": "https://contracts.baobab-platform.com/control-plane/v1/domain.schema.json#/$defs/mappingId",
          "description": "Optional CorporateRelationship (or other) id that justifies PLATFORM_GROUP_AFFILIATE etc."
        },
        "admission_decision_id": {
          "type": "string",
          "description": "Optional admission decision identifier that authorised this platform relationship."
        },
        "source_authority": {
          "type": "string",
          "minLength": 1,
          "description": "Must be server-side for PLATFORM_OWNER, PLATFORM_OPERATOR, PLATFORM_GROUP_AFFILIATE."
        },
        "evidence_references": {
          "type": "array",
          "items": { "type": "string" }
        },
        "verified_by": { "type": "string" },
        "verified_at": { "type": "string", "format": "date-time" },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "PlatformAccount": {
      "type": "object",
      "additionalProperties": false,
      "description": "Commercial/administrative account. NOT a Tenant. Does not confer authorization.",
      "required": [
        "id",
        "display_name",
        "status",
        "effective_from"
      ],
      "properties": {
        "id": {
          "$ref": "https://contracts.baobab-platform.com/control-plane/v1/domain.schema.json#/$defs/mappingId"
        },
        "display_name": { "type": "string", "minLength": 1 },
        "primary_organisation_id": {
          "$ref": "https://contracts.baobab-platform.com/control-plane/v1/domain.schema.json#/$defs/canonicalEntityId"
        },
        "status": {
          "type": "string",
          "enum": ["ACTIVE", "SUSPENDED", "RETIRED", "PENDING"]
        },
        "effective_from": { "type": "string", "format": "date-time" },
        "effective_to": { "type": "string", "format": "date-time" },
        "billing_reference": {
          "type": "string",
          "description": "Opaque commercial/billing reference. No credentials."
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "PlatformAccountMembership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "platform_account_id",
        "member_type",
        "member_id",
        "status",
        "effective_from"
      ],
      "properties": {
        "id": {
          "$ref": "https://contracts.baobab-platform.com/control-plane/v1/domain.schema.json#/$defs/mappingId"
        },
        "platform_account_id": {
          "$ref": "https://contracts.baobab-platform.com/control-plane/v1/domain.schema.json#/$defs/mappingId"
        },
        "member_type": {
          "type": "string",
          "enum": ["ORGANISATION", "TENANT"]
        },
        "member_id": {
          "type": "string",
          "minLength": 1,
          "description": "Organisation canonical_entity_id or tenant_id according to member_type."
        },
        "role": {
          "type": "string",
          "description": "Commercial role within the account (e.g. BILLING_OWNER). Not an IAM role."
        },
        "status": {
          "type": "string",
          "enum": ["ACTIVE", "SUSPENDED", "RETIRED"]
        },
        "effective_from": { "type": "string", "format": "date-time" },
        "effective_to": { "type": "string", "format": "date-time" },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
