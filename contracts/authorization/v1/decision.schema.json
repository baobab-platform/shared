{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.baobab-platform.com/contracts/authorization/v1/decision.schema.json",
  "title": "AuthorizationDecision",
  "description": "Result of an authorization check, including reason codes.",
  "type": "object",
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["ALLOW", "DENY"]
    },
    "reason_code": {
      "type": "string",
      "description": "Machine‑readable reason (e.g., TENANT_SUSPENDED, MEMBERSHIP_MISSING)."
    },
    "context": {
      "$ref": "context.schema.json"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["decision", "timestamp"]
}