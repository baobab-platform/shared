{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.baobab-platform.com/contracts/authorization/v1/context.schema.json",
  "title": "AuthorizationContext",
  "description": "Resolved platform context after Control Plane authorization.",
  "type": "object",
  "properties": {
    "decision_id": {
      "type": "string",
      "format": "uuid"
    },
    "principal_id": {
      "type": "string",
      "format": "uuid"
    },
    "actor_type": {
      "$ref": "../../identity/v1/actor-type.schema.json"
    },
    "tenant_id": {
      "type": "string",
      "description": "Resolved tenant identifier."
    },
    "legal_entity_id": {
      "type": "string",
      "description": "Resolved legal entity identifier, if applicable."
    },
    "digital_estate_id": {
      "type": "string",
      "description": "Resolved Digital Estate identifier."
    },
    "market_id": {
      "type": "string",
      "description": "Resolved market identifier (e.g., ZA, UG)."
    },
    "capability_id": {
      "type": "string",
      "description": "Resolved platform capability (e.g., baobab-trade)."
    },
    "engine_instance_id": {
      "type": "string",
      "description": "Resolved engine instance to route the request."
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "delegation": {
      "$ref": "delegation.schema.json",
      "description": "Present only when this request is a delegated call (ADR-0008 §90-92). principal_id above remains the immediate, authenticated caller; delegation.subject_id is who the call is ultimately for. Absent for a service acting on its own behalf."
    }
  },
  "required": ["decision_id", "principal_id", "actor_type", "resolved_at"]
}