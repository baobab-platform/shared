{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.baobab-platform.com/finance/v1/budget-manage-request.schema.json",
  "title": "Finance F2 Manage governed budgets request",
  "description": "DRAFT/EXPERIMENTAL: Drafts, maker/checker approvals and bounded commitments; a request does not mint a spend grant. No provider, CP grant, native financial posting or approval implied.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scope",
    "operation",
    "idempotency_key"
  ],
  "properties": {
    "scope": {
      "$ref": "f2-f3-domain.schema.json#/$defs/scope"
    },
    "operation": {
      "enum": [
        "CREATE_DRAFT",
        "SUBMIT",
        "APPROVE",
        "REVISE",
        "RESERVE_COMMITMENT",
        "RELEASE_COMMITMENT"
      ]
    },
    "idempotency_key": {
      "$ref": "f2-f3-domain.schema.json#/$defs/idempotencyKey"
    },
    "resource_ref": {
      "$ref": "f2-f3-domain.schema.json#/$defs/resourceRef"
    },
    "expected_version": {
      "$ref": "f2-f3-domain.schema.json#/$defs/version"
    },
    "cost_centre_ref": {
      "$ref": "f2-f3-domain.schema.json#/$defs/resourceRef"
    },
    "allocated_amount": {
      "$ref": "f2-f3-domain.schema.json#/$defs/nonnegativeMoney"
    },
    "commitment_ref": {
      "$ref": "f2-f3-domain.schema.json#/$defs/resourceRef"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "operation"
        ],
        "properties": {
          "operation": {
            "const": "CREATE_DRAFT"
          }
        }
      },
      "then": {
        "required": [
          "cost_centre_ref",
          "allocated_amount"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "resource_ref"
              ]
            },
            {
              "required": [
                "expected_version"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "resource_ref",
          "expected_version"
        ]
      }
    }
  ]
}
