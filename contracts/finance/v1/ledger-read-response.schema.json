{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.baobab-platform.com/finance/v1/ledger-read-response.schema.json",
  "title": "Finance F1 ledger read response",
  "description": "DRAFT/EXPERIMENTAL wire contract. No provider, legal authority, scope allocation or production activation is implied.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scope",
    "completeness",
    "observed_at",
    "data_version",
    "snapshot_id",
    "finance_baselines",
    "view",
    "posting_state",
    "items"
  ],
  "properties": {
    "scope": {
      "$ref": "domain.schema.json#/$defs/scope"
    },
    "completeness": {
      "$ref": "domain.schema.json#/$defs/completeness"
    },
    "observed_at": {
      "$ref": "domain.schema.json#/$defs/timestamp"
    },
    "data_version": {
      "$ref": "domain.schema.json#/$defs/dataVersion"
    },
    "snapshot_id": {
      "$ref": "domain.schema.json#/$defs/snapshotId"
    },
    "view": {
      "$ref": "domain.schema.json#/$defs/view"
    },
    "posting_state": {
      "$ref": "domain.schema.json#/$defs/postingState"
    },
    "items": {
      "type": "array",
      "maxItems": 1000
    },
    "next_cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "not": {
        "pattern": "^\\s*$"
      }
    },
    "finance_baselines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "$ref": "domain.schema.json#/$defs/financeBaseline"
      },
      "$comment": "Exact historical approved baseline versions represented by this snapshot; all belong to the CP-authorised legal entity. Several versions may be required across a period. A superseded baseline is not rewritten as today's configuration."
    }
  },
  "$comment": "Completeness describes source quality, not whether pagination is finished. Never derive a grand total from one page; continuation retains the same snapshot and data version.",
  "allOf": [
    {
      "if": {
        "required": [
          "view"
        ],
        "properties": {
          "view": {
            "const": "chart_of_accounts"
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "$ref": "domain.schema.json#/$defs/chartRow"
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "view"
        ],
        "properties": {
          "view": {
            "const": "balances"
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "$ref": "domain.schema.json#/$defs/balanceRow"
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "view"
        ],
        "properties": {
          "view": {
            "const": "entries"
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "$ref": "domain.schema.json#/$defs/entryRow"
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "completeness"
        ],
        "properties": {
          "completeness": {
            "const": "withheld"
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "maxItems": 0
          }
        },
        "not": {
          "required": [
            "next_cursor"
          ]
        }
      }
    }
  ]
}
