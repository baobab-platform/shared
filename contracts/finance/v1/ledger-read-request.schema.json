{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.baobab-platform.com/finance/v1/ledger-read-request.schema.json",
  "title": "Finance F1 ledger read request",
  "description": "DRAFT/EXPERIMENTAL wire contract. No provider, legal authority, scope allocation or production activation is implied.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scope",
    "view"
  ],
  "properties": {
    "scope": {
      "$ref": "domain.schema.json#/$defs/scope"
    },
    "view": {
      "$ref": "domain.schema.json#/$defs/view"
    },
    "posting_state": {
      "$ref": "domain.schema.json#/$defs/postingState",
      "default": "POSTED"
    },
    "page_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "not": {
        "pattern": "^\\s*$"
      }
    },
    "snapshot_id": {
      "$ref": "domain.schema.json#/$defs/snapshotId"
    }
  },
  "$comment": "Resume tokens are opaque and bound to the exact scope/view/posting-state and current authority. A new request may not silently change an existing snapshot.",
  "dependentRequired": {
    "cursor": [
      "snapshot_id"
    ],
    "snapshot_id": [
      "cursor"
    ]
  }
}
