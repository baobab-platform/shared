{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.baobab-platform.com/finance/v1/payable-manage-request.schema.json",
  "title": "Finance F2 Manage governed payables request",
  "description": "DRAFT/EXPERIMENTAL: Supplier bills, credit notes, due dates, approvals and payment preparation; payment execution is forbidden. No provider, CP grant, native financial posting or approval implied.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scope",
    "operation",
    "idempotency_key"
  ],
  "properties": {
    "scope": {
      "$ref": "f2-f3-domain.schema.json#/$defs/scope"
    },
    "operation": {
      "enum": [
        "REGISTER_BILL",
        "SUBMIT",
        "APPROVE",
        "RECORD_CREDIT",
        "PREPARE_PAYMENT"
      ]
    },
    "idempotency_key": {
      "$ref": "f2-f3-domain.schema.json#/$defs/idempotencyKey"
    },
    "resource_ref": {
      "$ref": "f2-f3-domain.schema.json#/$defs/resourceRef"
    },
    "expected_version": {
      "$ref": "f2-f3-domain.schema.json#/$defs/version"
    },
    "source_document": {
      "$ref": "f2-f3-domain.schema.json#/$defs/sourceDocument"
    },
    "gross_amount": {
      "$ref": "f2-f3-domain.schema.json#/$defs/nonnegativeMoney"
    },
    "due_date": {
      "$ref": "f2-f3-domain.schema.json#/$defs/date"
    },
    "counterparty_ref": {
      "$ref": "f2-f3-domain.schema.json#/$defs/resourceRef"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "operation"
        ],
        "properties": {
          "operation": {
            "const": "REGISTER_BILL"
          }
        }
      },
      "then": {
        "required": [
          "source_document",
          "gross_amount",
          "due_date",
          "counterparty_ref"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "resource_ref"
              ]
            },
            {
              "required": [
                "expected_version"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "resource_ref",
          "expected_version"
        ]
      }
    },
    {
      "if": {
        "required": [
          "source_document"
        ]
      },
      "then": {
        "properties": {
          "source_document": {
            "allOf": [
              {
                "$ref": "f2-f3-domain.schema.json#/$defs/sourceDocument"
              },
              {
                "properties": {
                  "type": {
                    "enum": [
                      "PROCUREMENT_BILL",
                      "ERP_CREDIT_NOTE"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
