{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.baobab-platform.com/finance/v1/journal-manage-response.schema.json",
  "title": "Finance F1 journal manage response",
  "description": "Canonical DRAFT/EXPERIMENTAL wire shape. Trusted CP context and provider authorisation are out of band. Not an activated provider permission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "journal_ref",
    "version",
    "status",
    "observed_at"
  ],
  "properties": {
    "journal_ref": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "DRAFT",
        "SUBMITTED",
        "APPROVED",
        "POSTED",
        "REVERSED"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
