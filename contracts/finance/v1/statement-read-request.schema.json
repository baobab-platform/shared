{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.baobab-platform.com/finance/v1/statement-read-request.schema.json",
  "title": "Finance F1 statement read request",
  "description": "Canonical DRAFT/EXPERIMENTAL wire shape. Trusted CP context and provider authorisation are out of band. Not an activated provider permission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scope",
    "statement_type"
  ],
  "properties": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period_start",
        "period_end",
        "as_of",
        "currency"
      ],
      "properties": {
        "period_start": {
          "type": "string",
          "format": "date"
        },
        "period_end": {
          "type": "string",
          "format": "date"
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "currency": {
          "$ref": "../../erp/v1/domain.schema.json#/$defs/currency"
        }
      }
    },
    "statement_type": {
      "enum": [
        "TRIAL_BALANCE",
        "INCOME_STATEMENT",
        "BALANCE_SHEET",
        "CASH_FLOW"
      ]
    }
  }
}
