{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.baobab-platform.com/finance/v1/f2-f3-domain.schema.json",
  "title": "Finance F2/F3 common wire vocabulary",
  "description": "DRAFT/EXPERIMENTAL. Source identity is not legal authority; CP/IAM + originating event and ERP verify it.",
  "$defs": {
    "resourceRef": {
      "$ref": "domain.schema.json#/$defs/resourceRef"
    },
    "scope": {
      "$ref": "domain.schema.json#/$defs/scope"
    },
    "money": {
      "$ref": "domain.schema.json#/$defs/money"
    },
    "nonnegativeMoney": {
      "$ref": "domain.schema.json#/$defs/nonnegativeMoney"
    },
    "timestamp": {
      "$ref": "domain.schema.json#/$defs/timestamp"
    },
    "date": {
      "$ref": "domain.schema.json#/$defs/date"
    },
    "version": {
      "$ref": "domain.schema.json#/$defs/version"
    },
    "idempotencyKey": {
      "$ref": "domain.schema.json#/$defs/idempotencyKey"
    },
    "completeness": {
      "$ref": "domain.schema.json#/$defs/completeness"
    },
    "dataVersion": {
      "$ref": "domain.schema.json#/$defs/dataVersion"
    },
    "financeBaselines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "$ref": "domain.schema.json#/$defs/financeBaseline"
      }
    },
    "sourceDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "authority"
      ],
      "properties": {
        "type": {
          "enum": [
            "TRADE_INVOICE",
            "SUBSCRIPTIONS_INVOICE",
            "PROCUREMENT_BILL",
            "BANK_STATEMENT",
            "PAYMENT_SETTLEMENT",
            "EXPENSE_RECEIPT",
            "ERP_CREDIT_NOTE",
            "ERP_JOURNAL"
          ]
        },
        "id": {
          "$ref": "#/$defs/externalRef"
        },
        "authority": {
          "enum": [
            "baobab-trade",
            "baobab-subscriptions",
            "procurement",
            "baobab-erp",
            "settlement",
            "documents"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "TRADE_INVOICE"
              }
            }
          },
          "then": {
            "properties": {
              "authority": {
                "const": "baobab-trade"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "SUBSCRIPTIONS_INVOICE"
              }
            }
          },
          "then": {
            "properties": {
              "authority": {
                "const": "baobab-subscriptions"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "PROCUREMENT_BILL"
              }
            }
          },
          "then": {
            "properties": {
              "authority": {
                "const": "procurement"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "BANK_STATEMENT"
              }
            }
          },
          "then": {
            "properties": {
              "authority": {
                "const": "baobab-erp"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "PAYMENT_SETTLEMENT"
              }
            }
          },
          "then": {
            "properties": {
              "authority": {
                "const": "settlement"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "EXPENSE_RECEIPT"
              }
            }
          },
          "then": {
            "properties": {
              "authority": {
                "const": "documents"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "ERP_CREDIT_NOTE"
              }
            }
          },
          "then": {
            "properties": {
              "authority": {
                "const": "baobab-erp"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "ERP_JOURNAL"
              }
            }
          },
          "then": {
            "properties": {
              "authority": {
                "const": "baobab-erp"
              }
            }
          }
        }
      ],
      "$comment": "Authority identifies the canonical source domain/steward, NOT a provider selection or legal permission. ERP checks current CP/IAM issuer identity and signed source event/custody."
    },
    "commandStatus": {
      "enum": [
        "ACCEPTED",
        "REJECTED",
        "UNKNOWN"
      ]
    },
    "readCursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "not": {
        "pattern": "^\\s*$"
      }
    },
    "amountRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cost_ref",
        "amount",
        "classification"
      ],
      "properties": {
        "cost_ref": {
          "$ref": "#/$defs/resourceRef"
        },
        "amount": {
          "$ref": "#/$defs/money"
        },
        "classification": {
          "enum": [
            "OPEX",
            "CAPEX",
            "POLICY_PENDING"
          ]
        },
        "source_ref": {
          "$ref": "#/$defs/resourceRef"
        }
      }
    },
    "externalRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._:-]{5,127}$",
      "maxLength": 128,
      "$comment": "Opaque producer/custody reference (may be from another canonical engine); never a raw native SQL ID or caller authority."
    }
  }
}
