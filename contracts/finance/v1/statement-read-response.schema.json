{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.baobab-platform.com/finance/v1/statement-read-response.schema.json",
  "title": "Finance F1 statement read response",
  "description": "DRAFT/EXPERIMENTAL wire contract. No provider, legal authority, scope allocation or production activation is implied.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scope",
    "completeness",
    "observed_at",
    "data_version",
    "snapshot_id",
    "finance_baselines",
    "statement_type",
    "reconciliation",
    "lines"
  ],
  "properties": {
    "scope": {
      "$ref": "domain.schema.json#/$defs/scope"
    },
    "completeness": {
      "$ref": "domain.schema.json#/$defs/completeness"
    },
    "observed_at": {
      "$ref": "domain.schema.json#/$defs/timestamp"
    },
    "data_version": {
      "$ref": "domain.schema.json#/$defs/dataVersion"
    },
    "snapshot_id": {
      "$ref": "domain.schema.json#/$defs/snapshotId"
    },
    "statement_type": {
      "$ref": "domain.schema.json#/$defs/statementType"
    },
    "reconciliation": {
      "$ref": "domain.schema.json#/$defs/reconciliation"
    },
    "lines": {
      "type": "array",
      "maxItems": 10000
    },
    "finance_baselines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "$ref": "domain.schema.json#/$defs/financeBaseline"
      },
      "$comment": "Exact historical approved baseline versions represented by this snapshot; all belong to the CP-authorised legal entity. Several versions may be required across a period. A superseded baseline is not rewritten as today's configuration."
    }
  },
  "$comment": "A complete statement requires reconciliation to an ERP trial-balance version and approved policy. Partial/stale/withheld results are never represented as certified statements.",
  "allOf": [
    {
      "if": {
        "required": [
          "statement_type"
        ],
        "properties": {
          "statement_type": {
            "const": "TRIAL_BALANCE"
          }
        }
      },
      "then": {
        "properties": {
          "lines": {
            "items": {
              "$ref": "domain.schema.json#/$defs/trialBalanceLine"
            }
          }
        }
      },
      "else": {
        "properties": {
          "lines": {
            "items": {
              "$ref": "domain.schema.json#/$defs/statementLine"
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "completeness"
        ],
        "properties": {
          "completeness": {
            "const": "complete"
          }
        }
      },
      "then": {
        "properties": {
          "reconciliation": {
            "properties": {
              "status": {
                "const": "RECONCILED"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "completeness"
        ],
        "properties": {
          "completeness": {
            "const": "withheld"
          }
        }
      },
      "then": {
        "properties": {
          "lines": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
