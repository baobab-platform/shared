{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.baobab-platform.com/identity/v1/native-provider-targets.schema.json",
  "title": "Native IAM target-facet and management vocabulary only",
  "description": "An architecture-only inventory. Status TARGET_NOT_QUALIFIED forbids inferring support certification, ACTIVE provider registration, deployment or grants.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "authority",
    "status",
    "providers",
    "management_operations",
    "token_issuance"
  ],
  "properties": {
    "schema": {
      "const": "baobab-iam-native-targets"
    },
    "version": {
      "const": "1.0"
    },
    "authority": {
      "const": "ADR-IAM-0033"
    },
    "status": {
      "const": "TARGET_NOT_QUALIFIED"
    },
    "providers": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider_key",
          "implementation_key",
          "target_facets"
        ],
        "properties": {
          "provider_key": {
            "type": "string",
            "enum": [
              "baobab-iam.kratos",
              "baobab-iam.hydra",
              "baobab-iam.keycloak"
            ]
          },
          "implementation_key": {
            "type": "string",
            "enum": [
              "kratos",
              "hydra",
              "keycloak"
            ]
          },
          "target_facets": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "runtime-capability.schema.json#/$defs/runtimeCapability"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "provider_key": {
                  "const": "baobab-iam.kratos"
                }
              },
              "required": [
                "provider_key"
              ]
            },
            "then": {
              "properties": {
                "implementation_key": {
                  "const": "kratos"
                },
                "target_facets": {
                  "minItems": 8,
                  "maxItems": 8,
                  "items": {
                    "enum": [
                      "HUMAN_AUTHENTICATION",
                      "CREDENTIAL_MANAGEMENT",
                      "SESSION_MANAGEMENT",
                      "ACCOUNT_VERIFICATION",
                      "ACCOUNT_RECOVERY",
                      "MFA",
                      "PASSKEY",
                      "IDENTITY_LIFECYCLE_PROVISIONING"
                    ]
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "provider_key": {
                  "const": "baobab-iam.hydra"
                }
              },
              "required": [
                "provider_key"
              ]
            },
            "then": {
              "properties": {
                "implementation_key": {
                  "const": "hydra"
                },
                "target_facets": {
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "enum": [
                      "OAUTH_AUTHORIZATION_SERVER",
                      "OIDC_PROVIDER",
                      "WORKLOAD_TOKEN_ISSUANCE"
                    ]
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "provider_key": {
                  "const": "baobab-iam.keycloak"
                }
              },
              "required": [
                "provider_key"
              ]
            },
            "then": {
              "properties": {
                "implementation_key": {
                  "const": "keycloak"
                },
                "target_facets": {
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {
                    "enum": [
                      "ENTERPRISE_SSO",
                      "SAML_FEDERATION",
                      "OIDC_FEDERATION",
                      "IDENTITY_BROKERING"
                    ]
                  }
                }
              }
            }
          }
        ]
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "provider_key": {
                "const": "baobab-iam.kratos"
              }
            },
            "required": [
              "provider_key"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "provider_key": {
                "const": "baobab-iam.hydra"
              }
            },
            "required": [
              "provider_key"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "provider_key": {
                "const": "baobab-iam.keycloak"
              }
            },
            "required": [
              "provider_key"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "management_operations": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "$ref": "iam-management-operation.schema.json#/$defs/managementOperation"
      }
    },
    "token_issuance": {
      "const": "SUBSUMED_IN_EXISTING_AUTHENTICATION_AND_WORKLOAD_CAPABILITIES"
    }
  }
}
