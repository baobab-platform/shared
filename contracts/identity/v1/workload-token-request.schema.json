{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.baobab-platform.com/identity/v1/workload-token-request.schema.json",
  "title": "Workload Token Request",
  "description": "Request for workload (machine-to-machine) access token following ADR-0006 OAuth client credentials profile.",
  "$defs": {
    "WorkloadTokenRequest": {
      "type": "object",
      "required": ["grant_type", "client_id"],
      "additionalProperties": false,
      "properties": {
        "grant_type": {
          "const": "client_credentials",
          "description": "OAuth grant type (always 'client_credentials' for workload/M2M)"
        },
        "client_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "Workload client identifier, registered with Baobab IAM"
        },
        "client_secret": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1000,
          "description": "Client secret (if using basic authentication via HTTP Authorization header, this may be omitted)"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Requested scope(s) (e.g. 'context:resolve trades:read erp:write')"
        },
        "audience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "Target audience/resource server (resource indicator per OAuth draft-ietf-oauth-resource-indicators)"
        },
        "realm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "description": "IAM realm/tenant context"
        }
      }
    }
  },
  "$ref": "#/$defs/WorkloadTokenRequest"
}
