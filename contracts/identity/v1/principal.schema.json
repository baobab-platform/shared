{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.baobab-platform.com/contracts/identity/v1/principal.schema.json",
  "title": "Principal",
  "description": "The canonical identity of an actor (human, workload, or external entity) within the Baobab platform.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Opaque, immutable, globally unique identifier for the principal."
    },
    "actor_type": {
      "$ref": "actor-type.schema.json"
    },
    "status": {
      "type": "string",
      "enum": ["ACTIVE", "SUSPENDED", "DISABLED", "ARCHIVED"],
      "description": "Lifecycle state of the principal."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["id", "actor_type", "status", "created_at", "updated_at"],
  "additionalProperties": false
}