{
  "name": "Nabhold Shared Contracts",
  "image": "ghcr.io/nabhold/baobab-dev:1.4.2-frontend",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "updateContentCommand": "pnpm install --frozen-lockfile --ignore-scripts",
  "postCreateCommand": "baobab-verify --contract && pnpm lint",
  "customizations": {
    "vscode": {
      "extensions": [
        "davidanson.vscode-markdownlint",
        "redhat.vscode-yaml",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
