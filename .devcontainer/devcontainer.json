{
  "name": "Baobab Shared Contracts — governed development",
  "image": "ghcr.io/baobab-platform/baobab-dev:1.5.1-frontend@sha256:388d604293fc6a2046d1abb9c7b80b32e78c6003636b091d1e9c7c827e34766d",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "init": true,
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "containerEnv": {
    "TZ": "Africa/Johannesburg",
    "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0",
    "NEXT_TELEMETRY_DISABLED": "1"
  },
  "forwardPorts": [],
  "portsAttributes": {},
  "otherPortsAttributes": {
    "visibility": "private",
    "onAutoForward": "silent"
  },
  "updateContentCommand": "node --test scripts/codespaces/*.node.mjs",
  "postCreateCommand": "node scripts/codespaces/bootstrap.mjs && baobab-verify --contract",
  "postStartCommand": "node scripts/codespaces/private-npm.mjs",
  "waitFor": "postCreateCommand",
  "customizations": {
    "codespaces": {
      "repositories": {
        "baobab-platform/baobab-dev": {
          "permissions": {
            "contents": "read",
            "packages": "read"
          }
        }
      },
      "openFiles": [
        "README.md"
      ]
    },
    "vscode": {
      "extensions": [
        "davidanson.vscode-markdownlint",
        "redhat.vscode-yaml",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}

