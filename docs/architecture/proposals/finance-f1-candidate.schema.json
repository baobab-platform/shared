{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.baobab-platform.com/proposals/finance/f1-candidate.schema.json",
  "title": "Finance F1 proposed wire contracts \u2014 NOT canonical or provider certified",
  "description": "Review-only design for SH-NAB-FIN-02. Do not deploy/register without Shared steward and ERP owner approval, catalogue promotion and conformance tests. CP authenticates and provides trusted tenant, Organisation, legal actor and legal-entity context outside user payload.",
  "$defs": {
    "decimal": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,8})?$",
      "description": "Decimal string, no floating point or exponent; scale is further restricted by ISO currency policy.",
      "maxLength": 64,
      "allOf": [
        {
          "not": {
            "pattern": "\\s"
          }
        }
      ]
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/date"
        },
        "end": {
          "$ref": "#/$defs/date"
        }
      }
    },
    "completeness": {
      "enum": [
        "complete",
        "partial",
        "stale",
        "withheld"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period",
        "as_of",
        "currency"
      ],
      "properties": {
        "period": {
          "$ref": "#/$defs/period"
        },
        "as_of": {
          "$ref": "#/$defs/dateTime"
        },
        "currency": {
          "$ref": "#/$defs/currency"
        }
      },
      "description": "No caller-supplied tenant/legal_entity_id; context comes from verified CP resolution."
    },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "$ref": "#/$defs/decimal"
        },
        "currency": {
          "$ref": "#/$defs/currency"
        }
      }
    },
    "ledgerReadRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "view"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "view": {
          "enum": [
            "chart_of_accounts",
            "balances",
            "entries"
          ]
        },
        "posting_state": {
          "enum": [
            "draft",
            "posted",
            "all"
          ]
        }
      }
    },
    "statementReadRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "statement_type"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "statement_type": {
          "enum": [
            "trial_balance",
            "income_statement",
            "balance_sheet",
            "cash_flow"
          ]
        }
      }
    },
    "readResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completeness",
        "scope",
        "observed_at",
        "data_version",
        "rows",
        "view"
      ],
      "properties": {
        "completeness": {
          "$ref": "#/$defs/completeness"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "observed_at": {
          "$ref": "#/$defs/dateTime"
        },
        "data_version": {
          "type": "string",
          "minLength": 1
        },
        "rows": {
          "type": "array",
          "maxItems": 1000
        },
        "view": {
          "enum": [
            "chart_of_accounts",
            "balances",
            "entries"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "view": {
                "const": "chart_of_accounts"
              }
            }
          },
          "then": {
            "properties": {
              "rows": {
                "items": {
                  "$ref": "#/$defs/chartRow"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "view": {
                "const": "balances"
              }
            }
          },
          "then": {
            "properties": {
              "rows": {
                "items": {
                  "$ref": "#/$defs/balanceRow"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "view": {
                "const": "entries"
              }
            }
          },
          "then": {
            "properties": {
              "rows": {
                "items": {
                  "$ref": "#/$defs/entryRow"
                }
              }
            }
          }
        }
      ],
      "$comment": "View is echoed and discriminates closed row shapes. No journal or chart metadata is forced into a balance-only row. Statement response semantics are a separate promotion decision."
    },
    "journalLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_ref",
        "debit",
        "credit"
      ],
      "properties": {
        "account_ref": {
          "type": "string",
          "minLength": 1
        },
        "debit": {
          "$ref": "#/$defs/decimal"
        },
        "credit": {
          "$ref": "#/$defs/decimal"
        },
        "description": {
          "type": "string",
          "maxLength": 512
        }
      },
      "oneOf": [
        {
          "properties": {
            "debit": {
              "$ref": "#/$defs/positiveDecimal"
            },
            "credit": {
              "$ref": "#/$defs/zeroDecimal"
            }
          }
        },
        {
          "properties": {
            "credit": {
              "$ref": "#/$defs/positiveDecimal"
            },
            "debit": {
              "$ref": "#/$defs/zeroDecimal"
            }
          }
        }
      ],
      "$comment": "Both fields are explicit: exactly one positive magnitude and one zero counterpart. A zero-only line, negative amount or dual positive line is invalid."
    },
    "journalDraftRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period",
        "currency",
        "lines",
        "idempotency_key"
      ],
      "properties": {
        "period": {
          "$ref": "#/$defs/period"
        },
        "currency": {
          "$ref": "#/$defs/currency"
        },
        "lines": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/journalLine"
          },
          "maxItems": 1000
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128
        },
        "reference": {
          "type": "string",
          "maxLength": 128
        }
      },
      "description": "A draft has one positive debit or credit on each line, with zero on the opposite side. ERP must separately enforce balanced totals, currency precision, chronological/open periods, CP authority, payload-scoped idempotency and distinct maker/checker Principals."
    },
    "journalTransitionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "journal_ref",
        "action",
        "expected_version",
        "idempotency_key"
      ],
      "properties": {
        "journal_ref": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "enum": [
            "submit",
            "approve",
            "post",
            "reverse"
          ]
        },
        "expected_version": {
          "type": "integer",
          "minimum": 1
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128
        },
        "reason": {
          "type": "string",
          "maxLength": 1024
        }
      },
      "description": "Approval/posting must re-resolve current CP grants and deny maker=checker even with privileged roles."
    },
    "positiveDecimal": {
      "allOf": [
        {
          "$ref": "#/$defs/decimal"
        },
        {
          "pattern": "^[0-9]"
        },
        {
          "not": {
            "pattern": "^0(?:\\.0+)?$"
          }
        }
      ],
      "$comment": "Strictly positive magnitude; decimal strings remain exact. Precision and balancing are ERP policy."
    },
    "zeroDecimal": {
      "type": "string",
      "pattern": "^0(?:\\.0{1,8})?$",
      "not": {
        "pattern": "\\s"
      }
    },
    "chartRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_ref",
        "account_code",
        "name",
        "account_type",
        "normal_balance",
        "postable"
      ],
      "properties": {
        "account_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "account_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "account_type": {
          "enum": [
            "ASSET",
            "LIABILITY",
            "EQUITY",
            "INCOME",
            "EXPENSE"
          ]
        },
        "normal_balance": {
          "enum": [
            "DEBIT",
            "CREDIT"
          ]
        },
        "postable": {
          "type": "boolean"
        }
      }
    },
    "balanceRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_ref",
        "account_code",
        "balance"
      ],
      "properties": {
        "account_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "account_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "balance": {
          "$ref": "#/$defs/money"
        }
      }
    },
    "entryRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_ref",
        "journal_ref",
        "account_ref",
        "account_code",
        "posting_date",
        "posting_state",
        "debit",
        "credit"
      ],
      "properties": {
        "entry_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "journal_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "account_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "account_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "posting_date": {
          "$ref": "#/$defs/date"
        },
        "posting_state": {
          "enum": [
            "DRAFT",
            "POSTED"
          ]
        },
        "debit": {
          "$ref": "#/$defs/decimal"
        },
        "credit": {
          "$ref": "#/$defs/decimal"
        }
      },
      "oneOf": [
        {
          "properties": {
            "debit": {
              "$ref": "#/$defs/positiveDecimal"
            },
            "credit": {
              "$ref": "#/$defs/zeroDecimal"
            }
          }
        },
        {
          "properties": {
            "credit": {
              "$ref": "#/$defs/positiveDecimal"
            },
            "debit": {
              "$ref": "#/$defs/zeroDecimal"
            }
          }
        }
      ]
    }
  }
}
