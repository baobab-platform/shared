{
  "name": "@baobab-platform/experience-storybook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006 --no-open",
    "build": "storybook build -o storybook-static",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@baobab-platform/experience-ui": "workspace:*",
    "@baobab-platform/experience-tokens": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.1",
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.3.0",
    "storybook": "10.6.0",
    "typescript": "6.0.3",
    "prettier": "3.9.8"
  }
}
