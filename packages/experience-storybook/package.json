{
  "name": "@baobab-platform/experience-storybook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006 --no-open",
    "build": "storybook build -o storybook-static",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:e2e": "node scripts/check-maplibre-worker-version.mjs && playwright test"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@baobab-platform/experience-geo-maplibre": "workspace:*",
    "@baobab-platform/experience-ui": "workspace:*",
    "@baobab-platform/experience-tokens": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "maplibre-gl": "6.16.0",
    "@storybook/react-vite": "10.6.6",
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/addon-docs": "10.6.6",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.6",
    "@vitejs/plugin-react": "6.2.1",
    "vite": "8.3.6",
    "storybook": "10.6.6",
    "typescript": "6.0.3",
    "prettier": "3.9.10"
  }
}
