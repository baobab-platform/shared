{
  "name": "@baobab-platform/experience-tokens",
  "version": "0.1.0",
  "private": false,
  "description": "Deterministic semantic multi-brand tokens governed by ADR-SHARED-040",
  "engines": {
    "node": ">=24 <25"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "tokens",
    "README.md"
  ],
  "exports": {
    "./base.css": "./dist/base.css",
    "./themes/nabhold.css": "./dist/themes/nabhold.css",
    "./themes/zuribeans.css": "./dist/themes/zuribeans.css",
    "./themes/thamani.css": "./dist/themes/thamani.css",
    "./themes/baobab-platform.css": "./dist/themes/baobab-platform.css",
    "./tokens/*": "./tokens/*"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "node scripts/validate.mjs",
    "test": "node --test tests/*.test.mjs"
  }
}
